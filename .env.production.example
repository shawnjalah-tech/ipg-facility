APP_NAME="IPG Facility"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ipg.example.org
APP_TIMEZONE=Asia/Kuching
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
PUBLIC_REGISTRATION_ENABLED=false

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Use mysql for MySQL 8 or mariadb for MariaDB. See docs/DEPLOYMENT.md for SQLite.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ipg_facility
DB_USERNAME=ipg_facility
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=local
APP_MAINTENANCE_DRIVER=file
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=90

# Configure before using password recovery or email notifications.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.example.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=bookings@example.org
MAIL_FROM_NAME="IPG Facility"
